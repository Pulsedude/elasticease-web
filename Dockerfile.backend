# ------------- Backend Image ----------------
FROM alpine:latest

RUN apk update && \
    apk add python3 py3-pip

WORKDIR /elasticease

COPY requirements.txt .

RUN python3 -m venv .venv
RUN .venv/bin/pip install -r requirements.txt

COPY ./backend ./backend
CMD [".venv/bin/python", "backend/main.py"]

